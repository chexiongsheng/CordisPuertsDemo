{
  "name": "cordis-puerts-unity-bundle",
  "private": true,
  "version": "0.0.0",
  "description": "Webpack bundle of cordis core for PuerTS V8 runtime (Unity demo)",
  "scripts": {
    "build:cordis": "webpack --config webpack.cordis.config.js && tsc -p tsconfig.cordis.json",
    "build:timer": "webpack --config webpack.timer.config.js && tsc -p tsconfig.timer.json",
    "build:smoke": "webpack --config webpack.smoke.config.js",
    "build:game": "webpack --config webpack.game.config.js",
    "watch:game": "webpack --watch --config webpack.game.config.js",
    "build": "npm run build:cordis && npm run build:timer && npm run build:smoke && npm run build:game",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "cosmokit": "^1.8.1"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.9.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  }
}
